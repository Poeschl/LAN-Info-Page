{
  "name": "lan-page",
  "type": "module",
  "version": "0.1.0-dev",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --inspect --host 127.0.0.1",
    "build": "run-s build:nuxt build:CopyMigrations build:CopyLinksConfig",
    "build:nuxt": "nuxt build",
    "build:CopyMigrations": "npx cpy database/migrations .output",
    "build:CopyLinksConfig": "npx cpy config .output",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component"
  },
  "dependencies": {
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@nuxt/eslint": "^1.15.2",
    "bulma": "^1.0.4",
    "chalk": "^6.0.0",
    "jwt-decode": "^4.0.0",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "nuxt": "^4.4.2",
    "nuxt-auth-utils": "^0.5.29",
    "pg": "^8.19.0",
    "pg-flyway": "^1.3.2",
    "typeorm": "^0.3.28",
    "vue": "^3.5.29",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@nuxt/test-utils": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@vue/test-utils": "^2.4.6",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.7.0",
    "js-yaml": "^4.1.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
